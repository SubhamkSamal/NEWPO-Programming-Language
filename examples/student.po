
import "examples/messages.po"

welcome("Student")

name := taker("Enter student name: ")
age := taker("Enter student age: ")

say("")
say("Hello,", name)
say("Collecting your academic information...")
say("")

subjects := ["Mathematics", "Science", "English", "Art"]
subjects := remove(subjects, 3)

scores := []

counter := 0

loop counter < 3 {
    say("Enter marks for:", subjects[counter])

    mark := taker("Marks out of 100: ")

    scores := append(scores, mark)

    counter := counter + 1

    when counter == 2 {
        continue
    }

    when counter == 3 {
        break
    }
}

total := scores[0] + scores[1] + scores[2]

function calculate_average(total, count) {
    return total / count
}

average := calculate_average(total, length(scores))

grade := "F"

when average >= 90 {
    grade := "A"
} otherwise {
    when average >= 75 {
        grade := "B"
    } otherwise {
        when average >= 60 {
            grade := "C"
        } otherwise {
            when average >= 50 {
                grade := "D"
            }
        }
    }
}

result := "Fail"

when average >= 50 {
    result := "Pass"
}

scholarship := false

when average >= 75 {
    scholarship := true
}

remarks := "Needs improvement"

when average >= 50 {
    remarks := "Satisfactory"
}

when average >= 75 {
    remarks := "Good academic performance"
}

when average >= 90 {
    remarks := "Excellent academic performance"
}

student := {
    "name": name,
    "age": age,
    "average": average,
    "result": result,
    "grade": grade,
    "scholarship": scholarship,
    "remarks": remarks
}

say("")
say("========== ACADEMIC REPORT ==========")

say("Student:", student["name"])
say("Age:", student["age"])

say("")
say("Subjects:", subjects)
say("Marks:", scores)

say("Total:", total)
say("Average:", average)
say("Grade:", grade)
say("Result:", result)

say("")
say("Scholarship eligible:", scholarship)
say("Profile fields:", keys(student))
say("Number of subjects:", length(subjects))

when scholarship {
    say("Scholarship status: Eligible")
} otherwise {
    say("Scholarship status: Not eligible")
}

say("Is the student under 18?", age < 18)

say("")
say("Remarks:", remarks)
say("Student profile:", student)

goodbye(name)
